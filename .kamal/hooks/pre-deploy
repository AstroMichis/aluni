#!/bin/sh
# Run migrations once per deploy, before the new web containers boot,
# instead of on every container start.
#
# --roles=web: --primary picks the primary host *per role*, so without it the
# command runs once in web and once in worker at the same time and the second
# one fails with ActiveRecord::ConcurrentMigrationError.
echo "Running migrations on $KAMAL_HOSTS (version $KAMAL_VERSION)"
kamal app exec --primary --roles=web --version="$KAMAL_VERSION" "bin/rails db:prepare"
