<% content_for :title, t(".title", app_name: t("app_name")) %>
<% by_crop = report_area_by_crop(@farm) %>
<% max_area = [ by_crop.map(&:last).max.to_f, 0.001 ].max %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: back_to_menu_path, back_label: t("app.fields.back_to_menu"), title: t(".crumb"), section: :reports %>

  <main id="main" class="screen__body report">
    <header class="screen__header">
      <% if @season.any? %>
        <p class="text-label screen__eyebrow"><%= t(".eyebrow", from: l(@season.from, format: :long), to: l(@season.to, format: :long)) %></p>
      <% end %>
      <h1 class="text-display screen__title"><%= t(".headline") %></h1>
      <p class="screen__lede"><%= t(".lede", count: @farm.fields.size, area: hectares(@farm.total_area)) %></p>
      <div class="cluster cluster--sm report__actions">
        <span class="report__download-label"><%= t(".download") %></span>
        <%= report_download_links(class: "btn btn--secondary btn--sm") %>
      </div>
    </header>

    <section class="screen__section" aria-labelledby="report-crops">
      <h2 class="screen__section-title" id="report-crops"><%= t(".crops_title") %></h2>
      <% if by_crop.any? %>
        <ul class="meter-list" role="list">
          <% by_crop.each do |crop, area| %>
            <li class="meter-list__row">
              <span class="meter-list__name"><%= crop %></span>
              <span class="meter-list__bar"><span class="meter-list__fill" style="--share: <%= (area / max_area).round(3) %>"></span></span>
              <span class="meter-list__value"><%= hectares(area) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="screen__lede"><%= t("app.crops.show.none") %></p>
      <% end %>
    </section>

    <% if (weather = report_weather(@season)).any? %>
      <section class="screen__section" aria-labelledby="report-weather">
        <h2 class="screen__section-title" id="report-weather"><%= t(".weather_title") %></h2>
        <ul class="kpis" role="list">
          <% weather.each do |label, value, unit| %>
            <li class="kpi"><span class="kpi__label"><%= label %></span><span class="kpi__value"><%= value %><% if unit %> <small><%= unit %></small><% end %></span></li>
          <% end %>
        </ul>
        <p class="choice-set__hint"><%= t("app.weather.show.regional") %></p>
      </section>
    <% end %>

    <section class="screen__section" aria-labelledby="report-fields">
      <h2 class="screen__section-title" id="report-fields"><%= t(".fields_title") %></h2>
      <div class="data-table__scroll">
        <table class="report-table">
          <thead>
            <tr><% report_field_header.each do |label| %><th scope="col"><%= label %></th><% end %></tr>
          </thead>
          <tbody>
            <% @farm.fields.zip(report_field_rows(@farm)).each do |field, (name, *cells)| %>
              <tr>
                <th scope="row"><%= link_to name, app_field_path(field.key) %></th>
                <% cells.each do |cell| %><td><%= cell %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="screen__section" aria-labelledby="report-team">
      <h2 class="screen__section-title" id="report-team"><%= t(".team_title") %></h2>
      <p class="screen__lede"><%= report_team(Current.user.farmer_profile) %></p>
    </section>
  </main>
</div>
