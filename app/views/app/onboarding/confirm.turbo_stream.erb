<%= turbo_stream.update "onboarding-confirm", "" %>
<%= turbo_stream.replace "onboarding-progress" do %>
  <%= render "app/onboarding/progress", topic: @topic, index: @index, total: @total %>
<% end %>
<%= turbo_stream.replace "profile-preview" do %>
  <%= render "app/onboarding/profile_preview", snapshot: @snapshot %>
<% end %>
<%= turbo_stream.update "onboarding-location-tools" do %>
  <%= render "app/onboarding/location_tools", pin: @pin if @topic == "location" %>
<% end %>
<%= turbo_stream.update "onboarding-notice" do %>
  <%= render "app/onboarding/notice", text: @notice, tone: "success" %>
<% end %>
