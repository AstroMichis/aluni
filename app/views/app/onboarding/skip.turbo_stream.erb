<%= turbo_stream.update "onboarding-notice", "" %>
<%= turbo_stream.append "onboarding-messages" do %>
  <%= render "app/onboarding/divider", topic: @topic %>
  <%= render "app/onboarding/message", role: "assistant", text: @transition if @transition.present? %>
  <%= render "app/onboarding/completion" if @completed %>
<% end %>
<%= turbo_stream.replace "onboarding-progress" do %>
  <%= render "app/onboarding/progress", topic: @topic, index: @index, total: @total %>
<% end %>
