<% payload = @payload %>
<%= turbo_stream.update "onboarding-notice", "" %>
<%= turbo_stream.append "onboarding-messages" do %>
  <%= render "app/onboarding/message", role: "user", text: payload[:user_text] %>
  <%= render "app/onboarding/message", role: "assistant", text: payload[:assistant_text],
             tone: (payload[:refusal] ? "refusal" : (payload[:degraded] ? "degraded" : nil)) %>
  <% if payload[:degraded] %>
    <%= render "app/onboarding/notice", text: t("app.onboarding.show.degraded_note"), tone: "muted" %>
  <% end %>
  <% if payload[:transition].present? %>
    <%= render "app/onboarding/divider", topic: payload[:topic] %>
    <%= render "app/onboarding/message", role: "assistant", text: payload[:transition] %>
  <% end %>
  <% if payload[:completed] %>
    <%= render "app/onboarding/completion" %>
  <% end %>
<% end %>
<% if payload[:applied].present? %>
  <%# One toast at a time: Undo always restores the latest apply (session.last_applied). %>
  <%= turbo_stream.update "onboarding-toasts" do %>
    <%= render "shared/toast", message: applied_summary(payload[:applied]), type: "success",
               action: button_to(t("app.onboarding.show.undo"), undo_app_onboarding_path, class: "toast__action") %>
  <% end %>
  <%= turbo_stream.replace "profile-preview" do %>
    <%= render "app/onboarding/profile_preview", snapshot: @snapshot %>
  <% end %>
<% end %>
<%= turbo_stream.replace "onboarding-progress" do %>
  <%= render "app/onboarding/progress", topic: @topic, index: @index, total: @total %>
<% end %>
