<% content_for :title, t(".title") %>

<div class="onboarding">
  <%# Links and forms inside leave the frame (target _top); answers come as Turbo Streams. %>
  <%= turbo_frame_tag "ask-aluni", target: "_top", class: "onboarding__chat-frame" do %>
    <%= render "app/onboarding/chat" %>
  <% end %>

  <%# Only on its own page: the Ask Aluni panel (a frame request) takes the chat alone. %>
  <% unless turbo_frame_request? %>
    <aside id="chat-companion" class="onboarding__companion" data-mascot-dock aria-label="<%= t(".companion_label") %>">
      <div class="onboarding__mascot"><%= render "shared/mascot_companion" %></div>
      <details class="onboarding__preview card" open>
        <summary class="onboarding__preview-summary"><%= t(".preview.title") %></summary>
        <div class="card__body">
          <%= render "app/onboarding/profile_preview", snapshot: @snapshot %>
        </div>
      </details>
    </aside>
  <% end %>
</div>
