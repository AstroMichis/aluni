<%# The Ask Aluni chat itself: header, log, typing, notices, toasts and the
    composer. On its own page (app/onboarding/show) and inside the panel every
    app screen opens (shared/_ask_aluni), which loads this page's
    "ask-aluni" frame. The Turbo Stream answers target its ids, so it works
    the same in both. %>
<section class="chat onboarding__chat"
         aria-labelledby="onboarding-title"
         data-controller="chat"
         data-chat-messages-value="<%= { failed: t("app.onboarding.show.errors.failed") }.to_json %>"
         data-chat-notice-class="chat__notice chat__notice--warning">
  <header class="chat__header">
    <div class="chat__heading">
      <h1 id="onboarding-title" class="text-heading chat__title"><%= t("app.onboarding.show.title") %></h1>
      <p class="chat__lede"><%= t("app.onboarding.show.lede") %></p>
    </div>
    <%= render "app/onboarding/progress", topic: @topic, index: @index, total: @total %>
  </header>

  <div id="onboarding-messages" class="chat__log" data-chat-target="log" role="log" aria-live="polite" aria-relevant="additions">
    <% turns = transcript_turns(@turns) %>
    <% if turns.empty? %>
      <%= render "app/onboarding/message", role: "assistant", text: t("onboarding.welcome_message", name: Current.user.display_name) %>
    <% else %>
      <% turns.each_with_index do |turn, i| %>
        <%= render "app/onboarding/message", role: turn[:role], text: turn[:text], silent: i < turns.size - 1 %>
      <% end %>
    <% end %>
    <% if @onboarding_session.completed? %>
      <div class="chat__notice chat__notice--success" role="status">
        <span><%= t("app.onboarding.show.completed_notice") %></span>
        <%= link_to t("app.onboarding.show.back_home"), app_root_path, class: "chat__notice-link" %>
      </div>
    <% end %>
  </div>

  <div class="chat__typing" data-chat-target="typing" hidden>
    <%= render "app/onboarding/typing" %>
  </div>

  <div id="onboarding-notice" class="chat__notices" data-chat-target="notice"></div>

  <div id="onboarding-toasts" class="chat__toasts" aria-live="polite"></div>

  <%= render "app/onboarding/composer" %>
</section>
