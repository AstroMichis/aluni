<% content_for :title, t(".title", app_name: t("app_name")) %>
<% planted = @farm.fields.reject(&:empty?) %>
<% planted_area = planted.sum { |f| f.area_hectares * f.current_crops.sum(&:portion) } %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: back_to_menu_path, back_label: t("app.fields.back_to_menu"), title: t(".crumb"), section: :crops %>
  <%= render "app/fields/plot_defs" %>

  <main id="main" class="screen__body">
    <header class="screen__header">
      <h1 class="text-display screen__title"><%= t(".headline") %></h1>
      <p class="screen__lede">
        <%= planted.any? ? t(".summary", crops: planted.flat_map(&:current_crops).map { |c| crop_name(c) }.uniq.to_sentence, area: hectares(planted_area)) : t(".none") %>
      </p>
    </header>

    <ul class="crop-list" role="list">
      <% @farm.fields.each do |field| %>
        <% season = Weather::Season.for(field.observation("nasa_power")) %>
        <% crops = field.current_crops %>
        <% split = crops.size > 1 || crops.any? { |c| !c.whole_field? } %>
        <% (crops.presence || [ nil ]).each do |crop| %>
          <li class="crop-card<%= " crop-card--empty" unless crop %>">
            <%= link_to app_field_path(field.key), class: "crop-card__plot", aria: { label: plot_name(field) } do %>
              <% if split %>
                <%= render "app/field_layouts/map", crops: crops, size: "sm", highlight: crop.map_cells, label: crop_mix(field, crops) %>
              <% else %>
                <%= render "app/fields/plot", crop: crop, size: "sm", id: "plot-crop-#{field.key}" %>
              <% end %>
            <% end %>
            <div class="crop-card__body">
              <p class="crop-card__field"><%= plot_name(field) %> · <%= split ? t(".part", area: portion_area(field, crop.portion), total: field_area(field)) : field_area(field) %></p>
              <h2 class="crop-card__crop"><%= crop ? crop_name(crop) : t("app.fields.index.no_crop") %></h2>
              <% if crop %>
                <p class="crop-card__meta">
                  <% if (family = Crops::Agronomy.family(crop)) %><span class="tag"><%= t("app.crops.families.#{family}") %></span><% end %>
                  <% if crop.planting_month && crop.harvest_month %>
                    <span class="tag"><%= t(".season", from: t("date.month_names")[crop.planting_month], to: t("date.month_names")[crop.harvest_month]) %></span>
                  <% end %>
                </p>
                <%= render "app/crops/potential", field: field, crop: crop, season: season %>
                <%= render "shared/aluni", message: t("app.fields.show.tips.#{crop_shape(crop)}") unless split %>
              <% else %>
                <%= link_to t(".plant"), app_field_path(field.key, anchor: "planting"), class: "btn btn--primary btn--sm" %>
              <% end %>
            </div>
          </li>
        <% end %>
      <% end %>
    </ul>
  </main>
</div>
