<%# "Your field from space": the monthly NDVI at the pin (Fields::Vegetation, the "vegetation"
    observation from Landsat and Sentinel-2), with bare periods highlighted as cover crop windows.
    Local: field (a Fields::Farm field). Renders nothing until the observation has values. %>
<% vegetation = Fields::Vegetation.new(field.observation("vegetation")) %>
<% normal = Fields::VegetationNormal.new(field.observation("modis")) %>
<% if vegetation.present? %>
  <section class="vegetation card" aria-labelledby="vegetation-title-<%= field.key %>">
    <div class="card__body stack stack--md">
      <div>
        <p class="text-label vegetation__eyebrow"><%= t("app.vegetation.eyebrow") %></p>
        <h2 id="vegetation-title-<%= field.key %>" class="text-heading vegetation__title"><%= t("app.vegetation.title") %></h2>
        <p class="vegetation__lede"><%= t("app.vegetation.lede") %></p>
      </div>

      <ol class="vegetation__chart" role="list" aria-label="<%= t("app.vegetation.chart_label") %>">
        <% vegetation.months.each do |month| %>
          <% label = l(month.label_date, format: "%B %Y") %>
          <li class="vegetation__month vegetation__month--<%= month.cover || "unknown" %>">
            <% usual = normal.normal_for(month.month) %>
            <span class="vegetation__plot">
              <span class="vegetation__bar" style="--ndvi: <%= month.ndvi ? month.ndvi.clamp(0, 1).round(2) : 0 %>"></span>
              <% if usual %><span class="vegetation__normal" style="--normal: <%= usual.clamp(0, 1).round(2) %>"></span><% end %>
            </span>
            <span class="vegetation__label" aria-hidden="true"><%= l(month.label_date, format: "%b") %></span>
            <span class="sr-only">
              <%= month.known? ? t("app.vegetation.month", month: label, ndvi: number_with_precision(month.ndvi, precision: 2), cover: t("app.vegetation.covers.#{month.cover}")) : t("app.vegetation.month_unknown", month: label) %>
              <% if usual %><%= t("app.vegetation.normal_point", ndvi: number_with_precision(usual, precision: 2)) %><% end %>
            </span>
          </li>
        <% end %>
      </ol>
      <ul class="vegetation__legend cluster cluster--sm" role="list" aria-hidden="true">
        <% %w[green sparse bare unknown].each do |cover| %>
          <li class="vegetation__key vegetation__key--<%= cover %>"><%= t("app.vegetation.covers.#{cover}") %></li>
        <% end %>
        <% if normal.present? %><li class="vegetation__key vegetation__key--normal"><%= t("app.vegetation.normal_key", years: normal.years) %></li><% end %>
      </ul>

      <% if (period = vegetation.longest_bare) && period.months >= 2 %>
        <%= render "shared/aluni", message: t("app.vegetation.bare_window", months: period.months,
                                                from: l(period.from, format: "%B %Y"), to: l(period.to, format: "%B %Y")) %>
      <% else %>
        <%= render "shared/aluni", message: t("app.vegetation.covered") %>
      <% end %>

      <% if normal.present? %>
        <p class="vegetation__lede">
          <%= normal.below.any? ? t("app.vegetation.normal_below", months: normal.below.map { |m| l(Date.strptime(m, "%Y-%m"), format: "%B") }.to_sentence)
                                : t("app.vegetation.normal_usual") %>
        </p>
      <% end %>

      <details class="vegetation__about">
        <summary><%= t("app.vegetation.about_title") %></summary>
        <p><%= t("app.vegetation.about") %></p>
      </details>
      <p class="vegetation__source"><%= t("app.vegetation.source", missions: Fields::Vegetation::SOURCE) %></p>
    </div>
  </section>
<% end %>
