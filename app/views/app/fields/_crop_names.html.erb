<%# Crop name suggestions from the catalog (config/crops.yml), once per page. %>
<% unless @crop_names_rendered %>
  <% @crop_names_rendered = true %>
  <datalist id="crop-names">
    <% Crops::Catalog.entries.each_value do |entry| %>
      <option value="<%= t("app.crops.names.#{entry.key}") %>" data-shape="<%= entry.shape %>"></option>
    <% end %>
  </datalist>
<% end %>
