<% name = plot_name(@field) %>
<% history = @field.history %>
<% cdl = @field.cdl_proposal %>
<% groups = @profile.groups(:field) %>
<% groups = groups.merge("crop" => groups["crop"].reject { |d| d.key == "crop_history" }) if history.any? %>
<% suggestions = @field.readings.count { |r| r.state == :to_confirm } + (cdl.any? ? 1 : 0) %>
<% content_for :title, t(".title", name: name, app_name: t("app_name")) %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: app_fields_path, back_label: t("app.fields.back_to_fields"), title: t("app.fields.index.crumb") %>
  <%= render "app/fields/plot_defs" %>

  <main id="main" class="screen__body" data-controller="section-nav" data-section-nav-current-class="section-nav__link--current">
    <header class="field-hero">
      <%= render "app/fields/plot", crop: @field.current_crop, size: "lg", id: "plot-hero-#{@field.key}" %>
      <div class="field-hero__copy">
        <h1 class="text-display screen__title"><%= name %></h1>
        <p class="screen__lede"><%= field_area(@field) %> · <%= @field.empty? ? t("app.fields.index.no_crop") : crop_name(@field.current_crop) %></p>
        <div class="cluster cluster--sm">
          <%= link_to t(".compare"), app_field_rotation_path(@field.key), class: "btn btn--primary btn--sm" unless @field.empty? %>
          <%= link_to t(".edit"), edit_app_field_path(@field.key), class: "btn btn--secondary btn--sm" %>
        </div>
        <% if @field.empty? %>
          <%= render "shared/aluni", message: t(".empty_message") %>
          <%= link_to t(".plant"), edit_app_field_path(@field.key, anchor: "field-current_crop"), class: "btn btn--primary" %>
        <% else %>
          <%= render "shared/aluni", message: t(".tips.#{crop_shape(@field.current_crop)}") %>
        <% end %>
      </div>
    </header>

    <% if (image = @field.image_url) %>
      <figure class="area-image">
        <img src="<%= image %>" alt="<%= t(".image_alt", name: name) %>" loading="lazy" width="480" height="480">
        <figcaption><%= t(".image_caption") %></figcaption>
      </figure>
    <% end %>

    <% if suggestions.positive? %>
      <section class="suggestions" aria-labelledby="suggestions-title">
        <h2 class="todo__title" id="suggestions-title"><%= t(".suggestions.title", count: suggestions) %></h2>
        <p class="choice-set__hint"><%= t(".suggestions.body") %></p>
        <div class="cluster cluster--sm">
          <%= button_to t(".suggestions.confirm_all"), confirm_app_field_path(@field.key), method: :post, class: "btn btn--primary btn--sm" %>
          <%= link_to t(".suggestions.review"), edit_app_field_path(@field.key), class: "btn btn--ghost btn--sm" %>
        </div>
      </section>
    <% end %>

    <%= render "app/fields/todo", subject: @field, edit_path: edit_app_field_path(@field.key) %>
    <%= render "app/fields/section_nav", groups: (history.any? ? ["history"] : []) + groups.keys + ["data-sources"] %>

    <% if history.any? || cdl.any? %>
      <section class="screen__section" id="group-history" aria-labelledby="group-title-history" data-section-nav-target="section">
        <h2 class="reading-group__title" id="group-title-history">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%= render "shared/glyph", name: "history" %></svg>
          <%= t("app.fields.groups.history") %>
        </h2>
        <% if history.any? %>
          <ol class="history" role="list">
            <% history.values.each_with_index do |crop, i| %>
              <% repeat = i.positive? && Crops::Agronomy.find(history.values[i - 1])&.key == Crops::Agronomy.find(crop)&.key && Crops::Agronomy.find(crop) %>
              <li class="history__year<%= " history__year--repeat" if repeat %>">
                <span class="history__label text-mono"><%= crop.season_year %></span>
                <span class="history__crop"><%= crop_name(crop) %></span>
                <span class="history__source"><%= t("app.fields.crop_sources.#{crop.source}") %></span>
                <% if repeat %><span class="history__flag"><%= t(".repeat") %></span><% end %>
              </li>
            <% end %>
          </ol>
        <% end %>
        <% if cdl.any? %>
          <p class="cdl-card"><%= t(".cdl", years: cdl.sort.map { |year, crop| "#{year}: #{crop}" }.join(" · ")) %></p>
        <% end %>
      </section>
    <% end %>

    <%= render "app/fields/groups", subject: @field, groups: groups %>
    <%= render "app/fields/sources_status", field: @field %>
  </main>
</div>
