<%# Why there is no season to show yet for the selected field. %>
<% observation = @field&.observation("nasa_power") %>
<% state = if @field.nil? || !@field.located? then "needs_pin" elsif observation&.failed? then "failed" else "pending" end %>
<section class="screen__section gap-card">
  <%= render "shared/aluni", message: t("app.weather.no_season.#{state}") %>
  <% if @field %>
    <%= link_to t("app.weather.no_season.open_field"), app_field_path(@field.key, tab: "data", anchor: state == "needs_pin" ? "group-plot" : "data-sources"), class: "btn btn--secondary btn--sm" %>
  <% end %>
</section>
