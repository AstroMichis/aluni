<% content_for :title, t(".menu_title", app_name: t("app_name")) %>
<% content_for :description, t(".lede") %>
<% selected = dial_index(params[:section]) %>
<% current = menu_sections.keys[selected] %>
<% current_title = t("app.home.show.sections.#{current}.title") %>
<% badges = menu_badges(@farm) %>

<div class="dial-page"
     data-controller="radial-menu"
     data-radial-menu-selected-class="dial__sector--selected"
     data-radial-menu-dragging-class="dial-page--dragging"
     data-tone="<%= current %>">
  <header class="dial-page__bar">
    <%= link_to t("app_name"), app_root_path, class: "dial-page__brand" %>
    <%# Everything in plain sight, no folded menu: language, theme, passkeys, sign out. %>
    <nav class="dial-page__tools" aria-label="<%= t(".account") %>">
      <%= render "shared/language_toggle" %>
      <button type="button" class="dial-tool" data-action="preferences#toggleTheme" aria-label="<%= t("theme.toggle") %>" title="<%= t("theme.toggle") %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%= render "shared/glyph", name: "theme" %></svg>
      </button>
      <%= link_to passkeys_path, class: "dial-tool", aria: { label: t("layouts.passkeys") }, title: t("layouts.passkeys") do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%= render "shared/glyph", name: "key" %></svg>
      <% end %>
      <%= button_to sign_out_path, method: :delete, class: "dial-tool", form_class: "dial-page__sign-out", aria: { label: t("layouts.sign_out") }, title: t("layouts.sign_out") do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%= render "shared/glyph", name: "sign_out" %></svg>
      <% end %>
    </nav>
  </header>

  <main id="main" class="dial-page__main">
    <div class="dial-page__stage" data-radial-menu-target="stage">
      <div class="dial-page__intro">
        <p class="text-label dial-page__eyebrow"><%= t(".eyebrow") %></p>
        <h1 class="text-display dial-page__title"><%= t(".greeting", name: Current.user.display_name) %></h1>
        <% if @plan_field %>
          <%= link_to app_field_rotation_path(@plan_field.key), class: "dial-page__plan" do %>
            <span class="dial-page__plan-title"><%= t(".plan.title") %></span>
            <span class="dial-page__plan-body"><%= t(".plan.body", crop: @plan_field.crop) %></span>
          <% end %>
        <% end %>
      </div>

      <div class="dial"
           data-radial-menu-target="wheel"
           data-action="pointerdown->radial-menu#press pointermove->radial-menu#move pointerup->radial-menu#release pointercancel->radial-menu#release wheel->radial-menu#scroll:!passive">
        <svg class="dial__svg" viewBox="-102 -102 204 204"
             role="slider" tabindex="0"
             aria-label="<%= t(".dial_label") %>"
             aria-valuemin="1" aria-valuemax="<%= menu_sections.size %>" aria-valuenow="<%= selected + 1 %>"
             aria-valuetext="<%= current_title %>"
             aria-describedby="dial-hint"
             data-radial-menu-target="dial"
             data-action="keydown->radial-menu#key">
          <defs>
            <path id="dial-wedge" d="<%= dial_wedge_path %>"/>
            <pattern id="dial-pattern-fields" class="dial__pattern" data-tone="fields" width="9" height="9" patternUnits="userSpaceOnUse">
              <circle cx="2.5" cy="2.5" r="1.3"/><circle cx="7" cy="6.5" r="1.6"/>
            </pattern>
            <pattern id="dial-pattern-crops" class="dial__pattern" data-tone="crops" width="12" height="11" patternUnits="userSpaceOnUse">
              <path d="M6 10V3.5M6 6.5L3.2 3.8M6 6.5l2.8-2.7"/>
            </pattern>
            <pattern id="dial-pattern-weather" class="dial__pattern" data-tone="weather" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M2 8.5l3-6M6.5 9.5l2.5-5"/>
            </pattern>
            <pattern id="dial-pattern-staff" class="dial__pattern" data-tone="staff" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M7.7 4a1.7 1.7 0 1 1-3.4 0 1.7 1.7 0 0 1 3.4 0zM2.8 10.5a3.2 3.2 0 0 1 6.4 0"/>
            </pattern>
            <pattern id="dial-pattern-reports" class="dial__pattern" data-tone="reports" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M3 11V7M6 11V3.5M9 11V6"/>
            </pattern>
          </defs>

          <circle class="dial__track" r="58"/>

          <g data-radial-menu-target="rotor" transform="rotate(<%= (-selected * dial_step).round(2) %>)">
            <path class="dial__tick" d="<%= dial_ticks_path(long: false) %>"/>
            <path class="dial__tick dial__tick--long" d="<%= dial_ticks_path(long: true) %>"/>

            <% menu_sections.each_key.with_index do |key, i| %>
              <% title = t("app.home.show.sections.#{key}.title") %>
              <g class="dial__sector<%= " dial__sector--selected" if i == selected %>"
                 transform="rotate(<%= (i * dial_step).round(2) %>)"
                 data-radial-menu-target="sector"
                 data-action="click->radial-menu#pick"
                 data-radial-menu-index-param="<%= i %>"
                 data-tone="<%= key %>"
                 data-kicker="<%= dial_kicker(i) %>"
                 data-title="<%= title %>"
                 data-description="<%= t("app.home.show.sections.#{key}.description") %>"
                 data-href="<%= menu_section_path(key) %>"
                 data-open-label="<%= t(".open_section", title: title) %>">
                <g class="dial__sector-enter" style="--i: <%= i %>">
                  <g class="dial__sector-body">
                    <use class="dial__wedge" href="#dial-wedge"/>
                    <use class="dial__wedge-lit" href="#dial-wedge"/>
                    <use class="dial__texture" href="#dial-wedge" fill="url(#dial-pattern-<%= key %>)"/>
                    <g transform="translate(0 -78)">
                      <g class="dial__label" data-radial-menu-target="label">
                        <g class="dial__icon" transform="translate(-7.5 -14) scale(0.625)">
                          <%= render "shared/glyph", name: key %>
                        </g>
                        <text class="dial__label-text" y="10.5" text-anchor="middle"><%= t("app.home.show.sections.#{key}.short") %></text>
                        <% if (count = badges[key]) %>
                          <g class="dial__badge" transform="translate(11.5 -8)">
                            <title><%= t(".pending", count: count) %></title>
                            <circle class="dial__badge-pulse" r="5.5"/>
                            <circle class="dial__badge-dot" r="5.5"/>
                            <text class="dial__badge-text" y="2.1" text-anchor="middle"><%= count > 9 ? "9+" : count %></text>
                          </g>
                        <% end %>
                      </g>
                    </g>
                  </g>
                </g>
              </g>
            <% end %>
          </g>

          <path class="dial__marker" d="M-3.2 -102 L3.2 -102 L0 -96.6 Z" aria-hidden="true"/>
        </svg>

        <a class="dial__hub" href="<%= menu_section_path(current) %>"
           data-radial-menu-target="hub"
           data-action="radial-menu#go"
           aria-label="<%= t(".open_section", title: current_title) %>">
          <span class="dial__hub-inner" aria-hidden="true">
            <span class="dial__kicker" data-radial-menu-target="kicker"><%= dial_kicker(selected) %></span>
            <span class="dial__hub-title" data-radial-menu-target="title"><%= current_title %></span>
            <span class="dial__hub-description" data-radial-menu-target="description"><%= t("app.home.show.sections.#{current}.description") %></span>
            <span class="dial__hub-open">
              <%= t(".open") %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      </div>

      <%# Step through the sections without turning the wheel: arrows either side, a dot per section. %>
      <div class="dial-steps">
        <button type="button" class="dial-steps__arrow" data-action="radial-menu#previous" aria-label="<%= t(".previous") %>" title="<%= t(".previous") %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <div class="dial-steps__dots">
          <% menu_sections.each_key.with_index do |key, i| %>
            <% title = t("app.home.show.sections.#{key}.title") %>
            <button type="button" class="dial-steps__dot" data-tone="<%= key %>"
                    data-radial-menu-target="dot" data-action="radial-menu#jump" data-radial-menu-index-param="<%= i %>"
                    aria-label="<%= t(".go_to", title: title) %>" title="<%= t(".go_to", title: title) %>"
                    <%= "aria-current=true" if i == selected %>></button>
          <% end %>
        </div>
        <button type="button" class="dial-steps__arrow" data-action="radial-menu#next" aria-label="<%= t(".next") %>" title="<%= t(".next") %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>

      <%# The selected section's options, one tap from the wheel. %>
      <div class="dial-options" aria-live="polite" data-radial-menu-target="optionsBox">
        <% menu_sections.each.with_index do |(key, options), i| %>
          <ul class="dial-options__list" role="list" data-radial-menu-target="options" data-tone="<%= key %>"
              aria-label="<%= t("app.home.show.sections.#{key}.title") %>"<%= " hidden" unless i == selected %>>
            <% options.each do |option| %>
              <% path = menu_option_path(key, option) %>
              <li>
                <%= content_tag(path ? :a : :div, href: path, class: ["dial-option", ("dial-option--primary" if option == options.first), ("dial-option--link" if path)],
                                data: (path ? { action: "radial-menu#go" } : {})) do %>
                  <span class="dial-option__glyph" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                      <%= render "shared/glyph", name: option %>
                    </svg>
                  </span>
                  <span class="dial-option__copy">
                    <span class="dial-option__title"><%= t("app.home.show.sections.#{key}.options.#{option}.title") %></span>
                    <span class="dial-option__body"><%= t("app.home.show.sections.#{key}.options.#{option}.body") %></span>
                  </span>
                  <% unless path %><span class="badge badge--secondary dial-option__badge"><%= t(".soon") %></span><% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <%# Next up: after the options on phones, beside the wheel from 1024 px. %>
      <% if (shortcuts = home_shortcuts(@farm)).any? %>
        <nav class="dial-page__shortcuts" aria-label="<%= t(".shortcuts.title") %>">
          <% shortcuts.each do |kind, label, path| %>
            <%= link_to path, class: "dial-page__shortcut dial-page__shortcut--#{kind}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <%= render "shared/glyph", name: { add: "add", suggestions: "tips", todo: "tasks", plan: "calendar" }.fetch(kind) %>
              </svg>
              <span><%= label %></span>
            <% end %>
          <% end %>
        </nav>
      <% end %>

      <p class="dial-page__hint" id="dial-hint"><%= t(".hint") %></p>
    </div>
  </main>

  <div class="dial-page__bloom" data-radial-menu-target="bloom" aria-hidden="true"></div>
</div>
