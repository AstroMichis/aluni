<% content_for :title, t(".title", app_name: t("app_name")) %>
<% yield_datum = @profile.fetch("yield") %>
<% planted = @farm.fields.reject(&:empty?) %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: menu_path, back_label: t("fields.back_to_menu"), title: t("reports.show.crumb"), section: :reports %>

  <main id="main" class="screen__body">
    <header class="screen__header">
      <h1 class="text-display screen__title"><%= t(".headline") %></h1>
      <p class="screen__lede"><%= t(".lede") %></p>
    </header>

    <%= render "shared/preview_note" %>

    <% if planted.empty? %>
      <p class="screen__lede"><%= t("crops.show.none") %></p>
    <% end %>

    <% planted.group_by(&:crop).each do |crop, fields| %>
      <% yields = fields.filter_map { |f| f.answers["yield"] } %>
      <section class="screen__section" aria-labelledby="harvest-<%= crop %>">
        <h2 class="screen__section-title" id="harvest-<%= crop %>"><%= crop_name(crop) %></h2>
        <ul class="harvest" role="list">
          <% fields.each do |field| %>
            <% value = field.answers["yield"] %>
            <li class="harvest__row" id="<%= field.reading(yield_datum).dom_id %>">
              <span class="harvest__name"><%= field_name(field) %> <small><%= hectares(field.area) %></small></span>
              <% if value %>
                <span class="meter-list__bar"><span class="meter-list__fill" style="--share: <%= (value / yields.max.to_f).round(3) %>"></span></span>
                <span class="harvest__value"><%= t(".per_ha", value: chart_number(value)) %> <small><%= t(".total", value: chart_number(value * field.area, 0)) %></small></span>
              <% else %>
                <span class="harvest__missing"><%= t(".missing") %></span>
              <% end %>
              <details class="reading__edit">
                <summary class="btn btn--ghost btn--sm"><%= t(value ? "fields.actions.change" : "fields.actions.answer") %></summary>
                <%= form_with url: menu_field_reading_path(subject: field.key, datum: "yield"), method: :patch, class: "reading__form" do %>
                  <%= render "fields/input", datum: yield_datum, name: "value", current: value %>
                  <button type="submit" class="btn btn--primary btn--sm"><%= t("fields.actions.save") %></button>
                <% end %>
              </details>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="screen__section gap-card" aria-labelledby="harvest-benchmark">
      <h2 class="screen__section-title" id="harvest-benchmark"><%= t(".benchmark.title") %></h2>
      <%= render "shared/aluni", message: t(".benchmark.body") %>
    </section>
  </main>
</div>
