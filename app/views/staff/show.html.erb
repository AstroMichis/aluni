<% content_for :title, t(".title", app_name: t("app_name")) %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: menu_path, back_label: t("fields.back_to_menu"), title: t(".crumb"), section: :staff %>

  <main id="main" class="screen__body">
    <header class="screen__header">
      <h1 class="text-display screen__title"><%= t(".headline") %></h1>
      <p class="screen__lede"><%= t(".lede", count: @farm.team.size + 1) %></p>
    </header>

    <%= render "shared/preview_note" %>
    <%= render "shared/aluni", message: t(".aluni") %>

    <ul class="people" role="list">
      <li class="person person--owner">
        <span class="person__avatar" aria-hidden="true"><%= t(".you").first %></span>
        <span class="person__body">
          <span class="person__name"><%= t(".you") %></span>
          <span class="person__meta"><%= t("staff.role_names.owner") %> · <%= t(".all_fields") %></span>
        </span>
      </li>
      <% @farm.team.each do |member| %>
        <% open_tasks = @farm.tasks.count { |task| task["member"] == member["id"] && !task["done"] } %>
        <li class="person" id="member-<%= member["id"] %>">
          <span class="person__avatar" aria-hidden="true"><%= member["name"].split.map(&:first).first(2).join %></span>
          <span class="person__body">
            <span class="person__name"><%= member["name"] %></span>
            <span class="person__meta">
              <%= t("staff.role_names.#{member["role"]}") %> ·
              <%= member["fields"].any? ? member["fields"].filter_map { |key| @farm.field(key) }.map { |f| field_name(f) }.to_sentence : t(".no_fields") %>
            </span>
            <span class="person__meta"><%= t(".open_tasks", count: open_tasks) %></span>
          </span>
          <details class="reading__edit person__edit">
            <summary class="btn btn--ghost btn--sm"><%= t(".edit") %></summary>
            <%= form_with url: member_menu_staff_path(member["id"]), method: :patch, class: "reading__form" do %>
              <%= render "staff/member_fields", member: member %>
              <div class="cluster cluster--sm">
                <button type="submit" class="btn btn--primary btn--sm"><%= t(".save") %></button>
              </div>
            <% end %>
            <%= button_to t(".remove"), member_menu_staff_path(member["id"]), method: :delete, class: "btn btn--ghost btn--sm person__remove",
                          form: { data: { turbo_confirm: t(".remove_confirm", name: member["name"]) } } %>
          </details>
        </li>
      <% end %>
    </ul>

    <section class="screen__section add-card" aria-labelledby="add-member">
      <h2 class="screen__section-title" id="add-member"><%= t(".add_title") %></h2>
      <%= form_with url: members_menu_staff_path, method: :post, class: "reading__form" do %>
        <label class="input-group">
          <span class="input-group__label"><%= t(".name") %></span>
          <input class="input" type="text" name="member[name]" maxlength="60" required autocomplete="off">
        </label>
        <%= render "staff/member_fields", member: { "role" => "worker", "fields" => [] } %>
        <button type="submit" class="btn btn--primary btn--sm"><%= t(".add") %></button>
      <% end %>
      <p class="choice-set__hint"><%= t(".invite_note") %></p>
    </section>
  </main>
</div>
