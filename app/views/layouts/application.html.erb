<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="dark">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app_name") %>">
    <meta name="theme-color" content="#0F2920" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#F1EBDD" media="(prefers-color-scheme: light)">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "base/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "base/reset", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "base/typography", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "base/global", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/button", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/card", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/badge", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/input", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/nav", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/modal", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/toast", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/dropdown", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/avatar", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/skeleton", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/tab-bar", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/language-toggle", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "layouts/container", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "layouts/grid", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "layouts/stack", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pages/app", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pages/auth", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "utilities/spacing", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "utilities/visibility", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "native", "data-turbo-track": "reload" if hotwire_native_app? %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme" class="app-shell">
    <a class="skip-link" href="#main"><%= t("layouts.skip_to_content") %></a>
    <div id="flash"><%= render "shared/flash" %></div>

    <header class="app-shell__header">
      <div class="container app-shell__header-inner">
        <%= link_to t("app_name"), app_root_path, class: "app-shell__brand" %>
        <nav class="app-shell__nav" aria-label="<%= t("layouts.app_nav") %>">
          <%= link_to t("layouts.home"), app_root_path, class: "app-shell__link #{'app-shell__link--active' if current_page?(app_root_path)}" %>
          <%= link_to t("layouts.passkeys"), passkeys_path, class: "app-shell__link #{'app-shell__link--active' if current_page?(passkeys_path)}" %>
          <%= button_to t("layouts.sign_out"), sign_out_path, method: :delete, class: "btn btn--ghost btn--sm", form_class: "app-shell__sign-out" %>
        </nav>
      </div>
    </header>

    <%# Native bridge mounts: no-ops in a browser, active inside the shells. %>
    <% if hotwire_native_app? && Platform::Features.push? %>
      <div data-controller="bridge--notification-token" data-bridge--notification-token-url-value="<%= app_device_tokens_path %>" hidden></div>
    <% end %>

    <main id="main" class="app-shell__main container container--md">
      <%= yield %>
    </main>
  </body>
</html>
