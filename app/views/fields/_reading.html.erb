<%# One datum of the farm or a field: its value or what is missing, where it
    comes from, and what the person can do with it right here. Locals: reading. %>
<% action = reading_action(reading) %>
<% url = menu_field_reading_path(subject: reading.subject.key, datum: reading.datum.key) %>
<li class="reading reading--<%= reading.state %>" id="<%= reading.dom_id %>">
  <span class="reading__label"><%= datum_label(reading.datum) %></span>
  <span class="reading__value"><%= reading_text(reading) %></span>
  <span class="reading__meta">
    <span class="reading__state"><%= t("fields.state_labels.#{reading.state}") %></span>
    <% if (origin = reading_origin(reading)).present? %><span class="reading__origin"><%= origin %></span><% end %>
  </span>

  <% if action %>
    <div class="reading__actions">
      <% if reading.state == :to_confirm %>
        <%= button_to t("fields.actions.confirm"), url, method: :patch, params: { confirm: 1 }, class: "btn btn--primary btn--sm", form_class: "reading__confirm" %>
      <% end %>
      <details class="reading__edit">
        <summary class="btn btn--ghost btn--sm"><%= t("fields.actions.#{action}") %></summary>
        <%= form_with url: url, method: :patch, class: "reading__form" do %>
          <% if reading.datum.asked?(reading.layer) || reading.state == :gap %>
            <%= render "fields/input", datum: reading.datum, name: "value", current: reading.value %>
          <% else %>
            <p class="reading__hint"><%= t("fields.actions.correct_hint") %></p>
            <input class="input" type="text" name="value" maxlength="<%= Fields::AnswerService::MAX_TEXT %>" aria-label="<%= datum_label(reading.datum) %>"
                   value="<%= reading.value if reading.state == :corrected %>">
          <% end %>
          <button type="submit" class="btn btn--primary btn--sm"><%= t("fields.actions.save") %></button>
        <% end %>
      </details>
    </div>
  <% end %>
</li>
