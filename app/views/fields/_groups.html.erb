<%# The data of the farm or a field, one section per group. Locals: subject, groups (group => data). %>
<% groups.each do |group, data| %>
  <section class="screen__section reading-group" id="group-<%= group %>" aria-labelledby="group-title-<%= group %>" data-section-nav-target="section">
    <h2 class="reading-group__title" id="group-title-<%= group %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <%= render "shared/glyph", name: group_glyph(group) %>
      </svg>
      <%= t("fields.groups.#{group}") %>
    </h2>
    <% if group == "climate" && subject.respond_to?(:period) && subject.period.any? %>
      <p class="reading-group__note"><%= t("fields.season_period", from: l(subject.period.first, format: :short), to: l(subject.period.last, format: :short)) %></p>
    <% end %>
    <ul class="reading-list" role="list">
      <%= render partial: "fields/reading", collection: subject.readings(data), as: :reading %>
    </ul>
  </section>
<% end %>
