<%# The illustrated field from the sketch: an empty plot with a pin, then the
    person's crop growing in rows. Needs fields/_plot_defs once on the page.
    Locals: crop (nil for an empty field), size ("sm" or "lg"), id (optional:
    the crop is part of it, so a new crop is a new element and grows in again
    after a morph), preview (true in the onboarding: plants wait for a crop). %>
<% shape = crop.present? ? crop_shape(crop) : nil %>
<% preview = local_assigns[:preview] %>
<svg class="plot plot--<%= size %><%= " plot--empty" unless shape %><%= " plot--#{shape}" if shape %>"
     <% if local_assigns[:id] %>id="<%= id %>-<%= shape || "empty" %>"<% end %>
     viewBox="0 0 200 140" aria-hidden="true" focusable="false"<% if preview %> data-onboarding-target="plot"<% end %>>
  <path class="plot__ground" d="M8 34 Q100 4 192 34 L156 126 Q100 136 44 126 Z"/>
  <path class="plot__soil" d="M8 34 Q100 4 192 34 L156 126 Q100 136 44 126 Z" fill="url(#plot-soil)"/>
  <% if shape || preview %>
    <% plot_plants.each do |plant| %>
      <use class="plot__plant" href="#plot-<%= shape || "leafy" %>" x="<%= plant[:x] - 8 %>" y="<%= plant[:y] - 24 %>" width="16" height="24" style="--i: <%= plant[:delay] %>"/>
    <% end %>
  <% end %>
  <% unless shape %><circle class="plot__pulse" cx="100" cy="78" r="10"/><% end %>
  <path class="plot__pin" d="M100 92c-5-6.5-8-11-8-15a8 8 0 0 1 16 0c0 4-3 8.5-8 15z"/>
  <circle class="plot__pin-dot" cx="100" cy="77" r="2.6"/>
</svg>
