<% content_for :title, t(".title", app_name: t("app_name")) %>
<% content_for :description, t(".lede") %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: menu_path, back_label: t("fields.back_to_menu"), title: t("fields.index.crumb"), section: :fields %>

  <main id="main" class="screen__body">
    <header class="screen__header">
      <p class="text-label screen__eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="text-display screen__title"><%= t(".headline") %></h1>
      <p class="screen__lede"><%= t(".lede") %></p>
    </header>

    <section class="screen__section" aria-labelledby="sources-legend">
      <h2 class="screen__section-title" id="sources-legend"><%= t(".legend_title") %></h2>
      <dl class="legend">
        <% %w[ask confirm auto].each do |origin| %>
          <div class="legend__item">
            <dt class="origin-tag origin-tag--<%= origin %>"><%= t("fields.origins.#{origin}") %></dt>
            <dd><%= t(".origins.#{origin}") %></dd>
          </div>
        <% end %>
        <% %w[high medium low].each do |confidence| %>
          <div class="legend__item">
            <dt class="confidence-tag confidence-tag--<%= confidence %>"><%= t("fields.confidence.#{confidence}") %></dt>
            <dd><%= t(".confidence.#{confidence}") %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <% %w[farm field].each do |level| %>
      <section class="screen__section" aria-labelledby="sources-<%= level %>">
        <h2 class="screen__section-title" id="sources-<%= level %>"><%= t(".levels.#{level}") %></h2>
        <% @profile.groups(level).each do |group, data| %>
          <h3 class="reading-group__title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%= render "shared/glyph", name: group_glyph(group) %></svg>
            <%= t("fields.groups.#{group}") %>
          </h3>
          <ul class="source-list" role="list">
            <% data.each do |datum| %>
              <li class="source-row<%= " source-row--gap" if datum.gap?("global") %>">
                <span class="source-row__label"><%= datum_label(datum) %></span>
                <span class="source-row__origin">
                  <% datum_origins(datum).each do |origin, layer| %>
                    <span class="origin-tag origin-tag--<%= origin %>"><%= t("fields.origins.#{origin}") %><%= " · #{t("fields.layers_short.#{layer}")}" if layer %></span>
                  <% end %>
                </span>
                <% unless datum.asked?("global") && datum.asked?("us") %>
                  <dl class="source-row__layers">
                    <% %w[global us].each do |layer| %>
                      <% sources = datum.sources[layer] %>
                      <% next if sources.empty? && layer == "us" %>
                      <div class="source-row__layer">
                        <dt><%= t("fields.layers_short.#{layer}") %></dt>
                        <dd>
                          <% if sources.empty? %>
                            <span class="source-row__missing"><%= t(".no_source") %></span>
                          <% else %>
                            <% sources.each do |source| %>
                              <span class="source-chip<%= " source-chip--missing" unless source.documented? %>">
                                <%= source.name %>
                                <span class="source-chip__res text-mono"><%= source.resolution %></span>
                                <% if source.confidence %>
                                  <span class="confidence-tag confidence-tag--<%= source.confidence %>"><%= t("fields.confidence.#{source.confidence}") %></span>
                                <% end %>
                                <% unless source.documented? %><span class="source-chip__note"><%= t(".undocumented") %></span><% end %>
                              </span>
                            <% end %>
                          <% end %>
                        </dd>
                      </div>
                    <% end %>
                  </dl>
                <% end %>
                <span class="source-row__feeds"><%= t(".feeds", uses: datum.feeds.map { |feed| t("fields.feeds.#{feed}") }.to_sentence) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    <% end %>

    <section class="screen__section" aria-labelledby="sources-gaps">
      <h2 class="screen__section-title" id="sources-gaps"><%= t(".gaps_title") %></h2>
      <p class="screen__lede"><%= t(".gaps_lede") %></p>
      <ul class="gap-list" role="list">
        <% @profile.gaps("global").each do |datum| %>
          <li><%= datum_label(datum) %></li>
        <% end %>
      </ul>
    </section>
  </main>
</div>
