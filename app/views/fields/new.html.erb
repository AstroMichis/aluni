<% content_for :title, t(".title", app_name: t("app_name")) %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: menu_fields_path, back_label: t("fields.back_to_fields"), title: t(".crumb") %>
  <%= render "fields/plot_defs" %>

  <%= form_with url: menu_fields_path, method: :post, id: "main", class: "screen__body onboarding",
                data: { controller: "onboarding", onboarding_current_class: "onboarding__step--current",
                        onboarding_rank_limit_value: 3, onboarding_empty_value: t(".review_empty"),
                        onboarding_edit_value: t(".review_edit"), action: "keydown.enter->onboarding#enter" } do %>
    <div class="onboarding__progress" role="progressbar" aria-label="<%= t(".progress") %>"
         aria-valuemin="1" aria-valuemax="<%= @steps.size %>" aria-valuenow="1" data-onboarding-target="progress">
      <span class="onboarding__progress-bar" data-onboarding-target="bar"></span>
    </div>

    <% @steps.each_with_index do |step, i| %>
      <section class="onboarding__step<%= " onboarding__step--current" if i.zero? %>"
               data-onboarding-target="step" aria-labelledby="step-<%= step.key %>" <%= "hidden" unless i.zero? %>>
        <p class="onboarding__count text-mono"><%= t(".count", number: i + 1, total: @steps.size) %></p>
        <h1 class="onboarding__question" id="step-<%= step.key %>" tabindex="-1"><%= t(".steps.#{step.key}.question") %></h1>
        <%= render "shared/aluni", message: t(".steps.#{step.key}.aluni") %>

        <%= render "fields/onboarding/#{step.input}", step: step %>

        <% feeds = step.data.flat_map(&:feeds).uniq - ["all"] %>
        <% if feeds.any? %>
          <p class="onboarding__why"><%= t(".why", uses: feeds.map { |feed| t("fields.feeds.#{feed}") }.to_sentence) %></p>
        <% end %>

        <div class="onboarding__nav">
          <% unless i.zero? %>
            <button type="button" class="btn btn--ghost" data-action="onboarding#back"><%= t(".back") %></button>
          <% end %>
          <% if i < @steps.size - 1 %>
            <button type="button" class="btn btn--primary" data-action="onboarding#next"><%= t(".next") %></button>
          <% else %>
            <button type="submit" class="btn btn--primary"><%= t(".save") %></button>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
