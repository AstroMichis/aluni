<%# The scripted landing chat (name, language, passkey). Hidden until the mascot's "Let's go"
    (window "mascot:lets-go"); landing_chat_controller.js runs the steps, passkey_controller.js the
    ceremony. #landing-chat-companion is where the mascot docks (mascot:dock { selector }). %>
<% if authenticated? %>
  <section class="chat-panel chat-panel--welcome" id="landing-chat"
           data-controller="landing-chat"
           data-landing-chat-locale-value="<%= I18n.locale %>"
           data-landing-chat-open-class="chat-panel--open"
           hidden aria-labelledby="landing-chat-title">
    <header class="chat-panel__header">
      <div id="landing-chat-companion" class="chat-panel__companion" data-mascot-dock data-landing-chat-target="companion">
        <span class="chat-panel__avatar" data-landing-chat-target="companionAvatar"><%= render "shared/mascot_avatar", size: "md" %></span>
      </div>
      <h2 id="landing-chat-title" class="chat-panel__title"><%= t("landing_chat.title", app_name: t("app_name")) %></h2>
      <button type="button" class="btn btn--ghost btn--sm chat-panel__close" data-action="landing-chat#close" aria-label="<%= t("landing_chat.close") %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>
    <div class="chat-panel__body stack stack--md">
      <p class="chat-panel__welcome"><%= t("landing_chat.welcome_back", name: Current.user.display_name) %></p>
      <%= link_to t("landing_chat.continue", app_name: t("app_name")), app_root_path, class: "btn btn--primary btn--lg btn--full" %>
    </div>
  </section>
<% elsif signups_enabled? %>
  <section class="chat-panel" id="landing-chat"
           data-controller="landing-chat passkey"
           data-passkey-mode-value="create"
           data-passkey-options-url-value="<%= sign_up_options_path %>"
           data-passkey-submit-url-value="<%= sign_up_path %>"
           data-passkey-messages-value="<%= passkey_messages %>"
           data-landing-chat-script-value="<%= landing_chat_script %>"
           data-landing-chat-locale-value="<%= I18n.locale %>"
           data-landing-chat-open-class="chat-panel--open"
           data-landing-chat-waiting-class="chat-panel--waiting"
           data-action="passkey:start->landing-chat#passkeyStarted passkey:error->landing-chat#passkeyFailed"
           hidden aria-labelledby="landing-chat-title">
    <header class="chat-panel__header">
      <div id="landing-chat-companion" class="chat-panel__companion" data-mascot-dock data-landing-chat-target="companion">
        <span class="chat-panel__avatar" data-landing-chat-target="companionAvatar"><%= render "shared/mascot_avatar", size: "md" %></span>
      </div>
      <h2 id="landing-chat-title" class="chat-panel__title"><%= t("landing_chat.title", app_name: t("app_name")) %></h2>
      <button type="button" class="btn btn--ghost btn--sm chat-panel__close" data-action="landing-chat#close" aria-label="<%= t("landing_chat.close") %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <div class="chat__log chat-panel__log" data-landing-chat-target="log" role="log" aria-live="polite" aria-relevant="additions"></div>

    <template data-landing-chat-target="assistantTemplate">
      <%= render "app/onboarding/message", role: "assistant", text: "" %>
    </template>
    <template data-landing-chat-target="userTemplate">
      <%= render "app/onboarding/message", role: "user", text: "" %>
    </template>

    <div class="chat-panel__steps">
      <form class="chat-panel__step chat-panel__name" data-landing-chat-target="nameForm" data-action="submit->landing-chat#submitName">
        <label class="sr-only" for="landing-chat-name"><%= t("landing_chat.script.name_label") %></label>
        <input id="landing-chat-name" class="input chat-panel__input" type="text" name="name" autocomplete="given-name" autocapitalize="words"
               maxlength="<%= User::NAME_MAX %>" required placeholder="<%= t("landing_chat.script.name_placeholder") %>" data-landing-chat-target="nameInput">
        <button type="submit" class="btn btn--primary chat-panel__submit"><%= t("landing_chat.script.name_submit") %></button>
      </form>

      <div class="chat-panel__step chat-panel__languages" data-landing-chat-target="languageStep" hidden>
        <button type="button" class="btn btn--secondary btn--lg" lang="en" data-locale="en" data-action="landing-chat#chooseLanguage"><%= t("landing_chat.script.english") %></button>
        <button type="button" class="btn btn--secondary btn--lg" lang="es" data-locale="es" data-action="landing-chat#chooseLanguage"><%= t("landing_chat.script.spanish") %></button>
      </div>

      <form class="chat-panel__step chat-panel__passkey stack stack--sm" data-landing-chat-target="passkeyStep" data-passkey-target="form" hidden novalidate>
        <input type="hidden" name="display_name" value="" data-landing-chat-target="displayNameField">
        <input type="hidden" name="locale" value="<%= I18n.locale %>" data-landing-chat-target="localeField">
        <button type="submit" class="btn btn--primary btn--lg btn--full" data-passkey-target="button" data-action="passkey#start" data-landing-chat-target="createButton">
          <%= t("landing_chat.script.create_passkey") %>
        </button>
        <p class="chat-panel__hint" data-landing-chat-target="hint"><%= t("landing_chat.script.passkey_hint") %></p>
        <p class="chat-panel__status auth__status" data-passkey-target="error" role="status" aria-live="polite"></p>
      </form>
    </div>

    <footer class="chat-panel__footer">
      <%= link_to t("landing_chat.have_account"), sign_in_path, class: "chat-panel__alt" %>
    </footer>
  </section>
<% end %>
