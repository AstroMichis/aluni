<ul class="phone-frame__alerts">
  <li class="phone-frame__alert phone-frame__alert--frost">
    <span class="phone-frame__alert-head">
      <span class="phone-frame__value"><%= t("#{scope}.frost") %></span>
      <span class="phone-frame__time"><%= t("#{scope}.now") %></span>
    </span>
    <span class="phone-frame__alert-body"><%= t("#{scope}.frost_body") %></span>
  </li>
  <li class="phone-frame__alert phone-frame__alert--scout">
    <span class="phone-frame__alert-head">
      <span class="phone-frame__value"><%= t("#{scope}.scout") %></span>
      <span class="phone-frame__time"><%= t("#{scope}.earlier") %></span>
    </span>
    <span class="phone-frame__alert-body"><%= t("#{scope}.scout_body", days: sample[:tar_spot_days]) %></span>
  </li>
  <li class="phone-frame__alert phone-frame__alert--dry">
    <span class="phone-frame__alert-head">
      <span class="phone-frame__value"><%= t("#{scope}.dry") %></span>
      <span class="phone-frame__time"><%= t("#{scope}.earlier") %></span>
    </span>
    <span class="phone-frame__alert-body"><%= t("#{scope}.dry_body", days: sample[:dry_days]) %></span>
  </li>
</ul>
