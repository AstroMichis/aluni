<%# One step of the guided tour: copy on one side, a simulated phone screen on the other. Keys are explicit (pages.home.*) because partials do not share the page's lazy scope. %>
<% scope = "pages.home.steps.#{step}" %>
<section id="tour-step-<%= number %>" class="tour-step tour-step--<%= step %>" data-scroll-story-target="step" aria-labelledby="tour-step-<%= number %>-title">
  <div class="container container--lg tour-step__inner">
    <div class="tour-step__copy">
      <p class="text-label tour-step__kicker"><%= t("pages.home.kicker", number: number, total: total) %></p>
      <h2 id="tour-step-<%= number %>-title" class="text-heading tour-step__title"><%= t("#{scope}.title") %></h2>
      <p class="tour-step__body"><%= t("#{scope}.body") %></p>
      <% if number == total %>
        <a class="btn btn--accent btn--lg tour-step__next" href="#get-the-app"><%= t("pages.home.finish") %></a>
      <% else %>
        <a class="btn btn--secondary btn--lg tour-step__next" href="#tour-step-<%= number + 1 %>"><%= t("pages.home.next", title: t("pages.home.steps.#{tour_steps[number]}.title")) %></a>
      <% end %>
    </div>
    <div class="tour-step__device">
      <%= render layout: "pages/home/phone_frame", locals: { title: t("#{scope}.phone_title") } do %>
        <%= render "pages/home/phone_#{step}", scope: scope, sample: landing_sample %>
      <% end %>
    </div>
  </div>
</section>
