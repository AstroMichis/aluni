<% content_for :title, t(".title") %>

<main id="main" class="auth container container--sm">
  <p class="auth__brand"><%= t("app_name") %></p>
  <section class="card">
    <div class="card__body stack stack--md">
      <h1 class="text-heading auth__title"><%= t(".title") %></h1>
      <p class="auth__lede"><%= t(".lede") %></p>
      <%= turbo_frame_tag "auth" do %>
        <%= render "sign_in_codes/choice", mode: "sign_up", error: nil %>
      <% end %>
      <p class="auth__alt"><%= t(".have_account") %> <%= link_to t(".sign_in"), sign_in_path %></p>
    </div>
  </section>
</main>
