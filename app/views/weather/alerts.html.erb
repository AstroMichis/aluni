<% content_for :title, t(".title", app_name: t("app_name")) %>
<% events = @season.events %>
<% frost_free = @season.frost_free %>

<div class="screen">
  <%= render "shared/screen_bar", back_path: menu_path, back_label: t("fields.back_to_menu"), title: t("weather.show.crumb"), section: :weather %>

  <main id="main" class="screen__body">
    <header class="screen__header">
      <h1 class="text-display screen__title"><%= t(".headline") %></h1>
      <p class="screen__lede"><%= t(".lede") %></p>
    </header>

    <%= render "shared/preview_note" %>

    <%= form_with url: alerts_menu_weather_path, method: :patch, class: "alert-prefs" do %>
      <h2 class="screen__section-title"><%= t(".prefs_title") %></h2>
      <input type="hidden" name="alerts[]" value="">
      <div class="choice">
        <% Weather::AlertsService::KINDS.each do |kind| %>
          <label class="choice__chip">
            <input type="checkbox" name="alerts[]" value="<%= kind %>"<%= " checked" if @farm.alerts.include?(kind) %>>
            <span><%= t(".kinds.#{kind}.label") %></span>
          </label>
        <% end %>
      </div>
      <p class="choice-set__hint"><%= t(".prefs_hint") %></p>
      <button type="submit" class="btn btn--primary btn--sm"><%= t(".save") %></button>
    <% end %>

    <section class="screen__section" aria-labelledby="frost-free">
      <h2 class="screen__section-title" id="frost-free"><%= t(".frost_free.title") %></h2>
      <p class="frost-free">
        <span><%= t(".frost_free.last_spring") %> <strong><%= frost_free[:last_spring] ? l(frost_free[:last_spring], format: :long) : t(".frost_free.none") %></strong></span>
        <span><%= t(".frost_free.first_fall") %> <strong><%= frost_free[:first_fall] ? l(frost_free[:first_fall], format: :long) : t(".frost_free.not_yet", date: l(@season.to, format: :long)) %></strong></span>
      </p>
    </section>

    <section class="screen__section" aria-labelledby="season-alerts">
      <h2 class="screen__section-title" id="season-alerts"><%= t(".timeline_title") %></h2>
      <%= render "shared/aluni", message: t(".timeline_aluni", count: events.count { |e| @farm.alerts.include?(e.kind) }) %>
      <ol class="timeline" role="list">
        <% events.each do |event| %>
          <li class="timeline__item timeline__item--<%= event.kind %><%= " timeline__item--off" unless @farm.alerts.include?(event.kind) %>">
            <span class="timeline__date text-mono"><%= l(event.from, format: :short) %><%= " – #{l(event.to, format: :short)}" if event.to %></span>
            <span class="timeline__kind"><%= t(".kinds.#{event.kind}.label") %></span>
            <span class="timeline__text"><%= t(".kinds.#{event.kind}.event", value: chart_number(event.value), days: event.days) %></span>
          </li>
        <% end %>
      </ol>
    </section>
  </main>
</div>
