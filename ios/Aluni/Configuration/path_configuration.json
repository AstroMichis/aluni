{
  "settings": {
    "tabs": [
      { "key": "home", "title": "Home", "url": "/app", "icon": "house" },
      { "key": "account", "title": "Account", "url": "/passkeys", "icon": "person.crop.circle" }
    ]
  },
  "rules": [
    {
      "patterns": [".*"],
      "properties": { "context": "default", "pull_to_refresh_enabled": true, "animated": true }
    },
    {
      "patterns": ["(/(en|es))?/(sign_in|sign_up)$"],
      "properties": { "context": "default", "presentation": "replace", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["(/(en|es))?/sign_in/(code|link)(/.*)?$"],
      "properties": { "context": "default", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["(/(en|es))?/sign_out$"],
      "properties": { "presentation": "clear_all" }
    },
    {
      "patterns": ["/new$", "/edit$"],
      "properties": { "context": "modal", "modal_style": "large", "modal_dismiss_gesture_enabled": false, "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["(/(en|es))?/passkeys$"],
      "properties": { "pull_to_refresh_enabled": false }
    }
  ]
}
