  "gaps": [
    {
      "gap": "normals",
      "why": "one year (2025) of daily data stands in for the 30-year NASA POWER normals the app uses"
    },
    {
      "gap": "nov_dec",
      "why": "data ends 2025-10-31; November and December are unknown months in the timeline"
    },
    {
      "gap": "profile",
      "why": "goals, equipment and irrigation are assumed (demo_farms.yml nebraska), not the Ames farmer's answers"
    },
    {
      "gap": "crop_fit",
      "why": "FAO GAEZ suitability is not in the CSV: crop_fit is left out of the total, as the app does when GAEZ has not answered"
    },
    {
      "gap": "perennial",
      "why": "the alfalfa strategy needs GAEZ to call alfalfa suitable (Comparator#suitable?), so it is not offered here"
    },
    {
      "gap": "imerg",
      "why": "storm penalty and stormy months use 2025 NASA POWER rain, not 20 years of GPM IMERG"
    },
    {
      "gap": "hourly_weather",
      "why": "gray leaf spot, northern corn leaf blight, rusts, Fusarium head blight and soybean rust need hourly T, RH and leaf wetness: NASA POWER hourly (pest_weather_rules.md) or the field station"
    },
    {
      "gap": "rotation_pests",
      "why": "corn rootworm and soybean cyst nematode, the Corn Belt pests rotation controls, have no documented rule or data source; pest_break scores only the family break"
    },
    {
      "gap": "faw_arrival",
      "why": "fall armyworm generations count from arrival, which needs FAMEWS or trap data"
    },
    {
      "gap": "market",
      "why": "margins use placeholder yields, prices and costs until NASS, AMS and ERS/ISU values go into ames_inputs.json"
    }
  ],
